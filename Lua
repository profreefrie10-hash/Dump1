-- === ฟังก์ชันหลัก: dump ===
local function r2(n) return math.floor(n * 100 + 0.5) / 100 end
local function v3(v) return { x = r2(v.X), y = r2(v.Y), z = r2(v.Z) } end
local function col(c) return { r = c.R, g = c.G, b = c.B } end

local function dumpPart(part)
    local d = {
        name = part.Name,
        className = part.ClassName,
        position = v3(part.Position),
        size = v3(part.Size),
        rotation = v3(part.Orientation),
        color = col(part.Color),
        material = part.Material.Name,
        transparency = r2(part.Transparency),
        canCollide = part.CanCollide,
        anchored = part.Anchored,
        parent = part.Parent and part.Parent:GetFullName() or "nil"
    }
    local mesh = part:FindFirstChildOfClass("SpecialMesh")
    if mesh then
        d.mesh = { meshId = mesh.MeshId, textureId = mesh.TextureId, scale = v3(mesh.Scale) }
    end
    local sa = part:FindFirstChildOfClass("SurfaceAppearance")
    if sa then
        d.surfaceAppearance = { colorMap = sa.ColorMap, normalMap = sa.NormalMap }
    end
    local decal = part:FindFirstChildOfClass("Decal")
    if decal then d.decal = { texture = decal.Texture } end
    return d
end

