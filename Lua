local function log(msg, color)
    local line = Instance.new("TextLabel")
    line.Size = UDim2.new(1, -12, 0, 16)
    line.BackgroundTransparency = 1
    line.Text = "> " .. msg
    line.TextColor3 = color or Color3.fromRGB(180, 200, 180)
    line.TextSize = 11
    line.Font = Enum.Font.Code
    line.TextXAlignment = Enum.TextXAlignment.Left
    line.TextWrapped = false
    line.Parent = logFrame

    -- จำกัด log แค่ 50 บรรทัด
    local count = 0
    for _, ch in ipairs(logFrame:GetChildren()) do
        if ch:IsA("TextLabel") then count = count + 1 end
    end
    if count > 50 then
        for _, ch in ipairs(logFrame:GetChildren()) do
            if ch:IsA("TextLabel") then ch:Destroy() break end
        end
    end

    task.defer(function()
        logFrame.CanvasPosition = Vector2.new(0, logFrame.AbsoluteCanvasSize.Y)
    end)
end

