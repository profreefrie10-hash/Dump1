local function runDump()
    if running then return end
    running = true
    cancelled = false

    toggleBtn.Text = "กำลังทำงาน... หยุด"
    toggleBtn.BackgroundColor3 = Color3.fromRGB(120, 50, 50)
    status.Text = "กำลังสแกน..."
    progressFill.Size = UDim2.new(0, 0, 1, 0)
    log("เริ่มสแกน workspace", Color3.fromRGB(140, 200, 255))

    local dump = {
        metadata = {
            placeId = game.PlaceId,
            jobId = game.JobId,
            timestamp = os.date("%Y-%m-%d %H:%M:%S"),
            executor = "Delta Mobile",
            partCount = 0,
            truncated = false
        },
        parts = {}
    }

    pcall(function()
        dump.metadata.gameName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
    end)

    local queue = collectParts()
    log("เจอ " .. #queue .. " Part", Color3.fromRGB(140, 255, 180))

    local total = math.min(#queue, CONFIG.MAX_PARTS)
    if #queue > CONFIG.MAX_PARTS then dump.metadata.truncated = true end

    local processed = 0
    local lastReport = tick()

    for i = 1, total do
        if cancelled then
            log("ผู้ใช้หยุดกลางทาง", Color3.fromRGB(255, 180, 120))
            break
        end

        local part = queue[i]
        if part and part.Parent then
            local ok, data = pcall(dumpPart, part)
            if ok then table.insert(dump.parts, data) end
        end

        processed = processed + 1

        if processed % CONFIG.BATCH_SIZE == 0 then
            task.wait(CONFIG.BATCH_WAIT)
            if tick() - lastReport >= 1 then
                local pct = processed / total
                progressFill.Size = UDim2.new(pct, 0, 1, 0)
                status.Text = string.format("กำลัง dump... %d/%d (%d%%)",
                    processed, total, math.floor(pct * 100))
                lastReport = tick()
            end
        end
    end

    progressFill.Size = UDim2.new(1, 0, 1, 0)
    dump.metadata.partCount = #dump.parts
    log("ประมวลเสร็จ: " .. dump.metadata.partCount .. " Part", Color3.fromRGB(140, 255, 180))

    status.Text = "กำลัง encode JSON..."
    local ok, json = pcall(function() return HttpService:JSONEncode(dump) end)
    if not ok then
        warn("[MapDumper] Encode ล้มเหลว")
        status.Text = "Encode ล้มเหลว"
        log("Encode ล้มเหลว", Color3.fromRGB(255, 120, 120))
        running = false
        toggleBtn.Text = "เริ่ม Dump"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 60)
        return
    end

    local sizeKB = math.floor(#json / 1024)
    log("ขนาด JSON: " .. sizeKB .. " KB", Color3.fromRGB(200, 200, 255))

    local filename = "mapdump_" .. game.PlaceId .. "_" .. os.time() .. ".json"
    local saved = false

    if hasWrite then
        local ok2 = pcall(writefile, filename, json)
        if ok2 then
            saved = true
            log("บันทึก: " .. filename, Color3.fromRGB(140, 255, 180))
        else
            log("เขียนไฟล์พัง", Color3.fromRGB(255, 120, 120))
        end
    else
        log("writefile ไม่มี", Color3.fromRGB(255, 180, 120))
    end

    if hasClipboard and sizeKB < 500 then
        local b64c = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        local function b64(data)
            local out, i, n = {}, 1, #data
            while i <= n do
                local b1, b2, b3 = data:byte(i) or 0, data:byte(i+1) or 0, data:byte(i+2) or 0
                local c1 = math.floor(b1 / 4)
                local c2 = (b1 % 4) * 16 + math.floor(b2 / 16)
                local c3 = (b2 % 16) * 4 + math.floor(b3 / 64)
                local c4 = b3 % 64
                out[#out+1] = b64c:sub(c1+1, c1+1)
                out[#out+1] = b64c:sub(c2+1, c2+1)
                out[#out+1] = i+1 <= n and b64c:sub(c3+1, c3+1) or "="
                out[#out+1] = i+2 <= n and b64c:sub(c4+1, c4+1) or "="
                i = i + 3
            end
            return table.concat(out)
        end
        pcall(setclipboard, "MAPDUMP_B64:" .. game.PlaceId .. ":" .. b64(json))
        log("คัดลอก base64 → คลิปบอร์ด", Color3.fromRGB(180, 220, 255))
    end

    status.Text = saved and ("เสร็จ — " .. dump.metadata.partCount .. " Part") or "เสร็จ (ดู log)"
    log("เสร็จสิ้น", Color3.fromRGB(140, 255, 180))
    notify("Dump เสร็จสิ้น: " .. dump.metadata.partCount .. " Part", true)

    running = false
    toggleBtn.Text = "เริ่ม Dump อีกครั้ง"
    toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 60)
end

